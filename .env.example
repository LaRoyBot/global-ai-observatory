# Global AI Observatory — environment configuration
# Copy to .env and adjust. EVERY variable is OPTIONAL: the platform runs fully
# without credentials, using public endpoints and local reference/synthetic data.
# Never commit a real .env. Server-side values are never sent to the browser.

# HTTP server
PORT=4173
HOST=127.0.0.1

# SQLite database file (created automatically; migrations run at startup)
DATABASE_PATH=./data/observatory.db

# Ingestion
INGEST_ON_START=false          # run public-source ingestion once at boot
INGEST_INTERVAL_MINUTES=0      # 0 disables the scheduled job
INGEST_TIMEOUT_MS=15000
INGEST_MAX_RETRIES=2

# Optional authenticated sources (leave empty to disable gracefully).
# These are NEVER exposed to client bundles; adapters skip when absent.
HUGGINGFACE_TOKEN=
OPENROUTER_API_KEY=
NEWSAPI_KEY=

# Behaviour
LOW_POWER_DEFAULT=false
LOG_LEVEL=info
